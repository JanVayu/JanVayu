#!/usr/bin/env bash
# Pre-commit hook: catch common mistakes before they're committed
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

echo "Running pre-commit checks..."

# 1. Block commits of sensitive files
SENSITIVE_PATTERNS=('.env' '.env.local' '.env.production' 'credentials.json' '*.pem' '*.key')
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

for pattern in "${SENSITIVE_PATTERNS[@]}"; do
  while IFS= read -r file; do
    if [[ -n "$file" ]]; then
      echo -e "${RED}BLOCKED:${NC} Refusing to commit sensitive file: $file"
      echo "If this is intentional, use: git commit --no-verify"
      exit 1
    fi
  done < <(echo "$STAGED_FILES" | grep -E "^${pattern//\*/.*}$" 2>/dev/null || true)
done

# 2. Check for debug/console statements in staged JS/TS/Python files
CODE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|py)$' || true)
if [ -n "$CODE_FILES" ]; then
  ISSUES=0
  while IFS= read -r file; do
    if git diff --cached "$file" | grep -E '^\+.*console\.(log|debug|warn)\(' | grep -v '// keep' > /dev/null 2>&1; then
      echo -e "${YELLOW}WARNING:${NC} console.log/debug/warn found in $file"
      ISSUES=$((ISSUES + 1))
    fi
    if git diff --cached "$file" | grep -E '^\+.*(debugger|breakpoint\(\))' > /dev/null 2>&1; then
      echo -e "${RED}BLOCKED:${NC} debugger statement found in $file"
      exit 1
    fi
  done <<< "$CODE_FILES"
  if [ $ISSUES -gt 0 ]; then
    echo -e "${YELLOW}Found $ISSUES file(s) with console statements. Consider removing them.${NC}"
  fi
fi

# 3. Check for merge conflict markers
#
# Matched at the start of a line and in the exact shape git writes them, not
# anywhere in the file: the loose pattern flagged docs/claude-code/capabilities.md
# for the table row that documents this very rule, and would flag any setext
# heading underline as well. Only the angle markers are matched, at column 1 and
# followed by a space or end of line: a bare '=======' is indistinguishable from
# a seven-character setext heading underline, and every real conflict git writes
# carries '<<<<<<<' and '>>>>>>>' too, so nothing is lost by leaving it out.
if [ -n "$STAGED_FILES" ]; then
  while IFS= read -r file; do
    if [ -f "$file" ] && grep -nE '^(<{7}|>{7})( |$)' "$file" > /dev/null 2>&1; then
      echo -e "${RED}BLOCKED:${NC} Merge conflict markers found in $file"
      exit 1
    fi
  done <<< "$STAGED_FILES"
fi

# 4. Block commits that empty or gut index.html (the entire app)
if echo "$STAGED_FILES" | grep -q '^index\.html$'; then
  if [ -f "index.html" ]; then
    LINES=$(git diff --cached --diff-filter=ACMR -- index.html | grep -c '^\-' || true)
    REMAINING=$(git show :index.html | wc -l)
    if [ "$REMAINING" -lt 100 ]; then
      echo -e "${RED}BLOCKED:${NC} index.html has been reduced to $REMAINING lines (the full app is ~13,000 lines)."
      echo "This would take down www.janvayu.in. If intentional, use: git commit --no-verify"
      exit 1
    fi
  fi
fi

# 5. Warn on large files (> 500KB)
while IFS= read -r file; do
  if [ -f "$file" ]; then
    SIZE=$(wc -c < "$file")
    if [ "$SIZE" -gt 512000 ]; then
      SIZE_KB=$((SIZE / 1024))
      echo -e "${YELLOW}WARNING:${NC} Large file (${SIZE_KB}KB): $file"
    fi
  fi
done <<< "$STAGED_FILES"

echo "Pre-commit checks passed."

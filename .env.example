# JanVayu Environment Variables
# Copy this file to .env and fill in the values

# Resend (email digests)
RESEND_API_KEY=
RESEND_FROM=digest@janvayu.in

# Netlify
BLOB_TOKEN=
NETLIFY_SITE_ID=

# Groq AI — runs the Ask JanVayu LLM (free key at https://console.groq.com).
# Model is overridable via GROQ_MODEL (default: openai/gpt-oss-120b).
GROQ_API_KEY=

# OpenAQ v3 — hyperlocal community/CPCB sensor coverage for India (free key at
# https://explore.openaq.org/account). When set, community-sensors.mjs uses
# OpenAQ as its primary source; without it, it falls back to Sensor.Community.
OPENAQ_API_KEY=

# Agent-Reach feed ingest — API key for GitHub Actions to push social media data
FEED_INGEST_KEY=

# Sarvam — Indian-language translation (auto-translates docs/ → docs-hi/bn/mr/ta/)
SARVAM_API_KEY=
